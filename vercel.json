{
  "version": 2,
  "outputDirectory": "dist",
  "functions": {
    "api/arms-verify.js": { "runtime": "edge" },
    "SSAAM_VERCEL_BACKEND.js": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "/apis/students/arms-verify", "dest": "/api/arms-verify.js" },
    { "src": "/apis/(.*)",                 "dest": "/SSAAM_VERCEL_BACKEND.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)",                      "dest": "/index.html" }
  ]
}
