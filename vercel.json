{
  "version": 2,
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "/api/auth/(.*)", "dest": "/api/index.js" },
    { "src": "/apis/(.*)",     "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)",          "dest": "/index.html" }
  ]
}