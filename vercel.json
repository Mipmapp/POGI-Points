{
  "version": 2,
  "builds": [
    {
      "src": "SSAAM_VERCEL_BACKEND.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/apis/students/arms-verify", "dest": "/api/arms-verify.js" },
    { "src": "/apis/(.*)", "dest": "/SSAAM_VERCEL_BACKEND.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
